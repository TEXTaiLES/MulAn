# Copy this file and name the copy ".env".
# Do NOT commit the .env file to git!

# --- MulAn ---
MULAN_PORT=5001
MULAN_DATA_DIR=./data
MULAN_RESOURCE_TTL_HOURS=24
MULAN_MAX_UPLOAD_MB=512
# Empty: taken from the request
MULAN_PUBLIC_URL=

# --- HESTIA ---
# With `docker compose up`, use http://host.docker.internal:5000
HESTIA_API_URL=http://localhost:5000
HESTIA_PORTAL_URL=http://localhost:8055
HESTIA_COOKIE_NAME=textailes_refresh_token
HESTIA_TIMEOUT_SECONDS=30
