# Port MulAn listens on (Docker, local Flask dev server, Vite proxy, Playwright).
# 5001 matches HESTIA's default MULAN_ORIGINS and keeps clear of the HESTIA API on 5000.
MULAN_PORT=5001
MULAN_DATA_DIR=./data
MULAN_RESOURCE_TTL_HOURS=24
MULAN_MAX_UPLOAD_MB=512

# HESTIA API, called by MulAn's backend (in Docker, use http://host.docker.internal:5000).
HESTIA_API_URL=http://localhost:5000
# HESTIA portal, where the browser is sent to sign in and out.
HESTIA_PORTAL_URL=http://localhost:8055
HESTIA_COOKIE_NAME=textailes_refresh_token
HESTIA_TIMEOUT_SECONDS=30
# Public URL of MulAn, used as the post-login redirect. Empty: derived from the request.
MULAN_PUBLIC_URL=
